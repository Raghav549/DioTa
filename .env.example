# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production AND Preview).
# NEVER commit real values.

# --- Required ---------------------------------------------------------------
# Postgres connection string (Neon, Supabase, Vercel Postgres, RDS, ...).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# 32 random bytes, base64. Encrypts vault items and payment details.
# Generate:  npm run gen:key   (or: openssl rand -base64 32)
# Keep it secret and NEVER change it after launch - existing encrypted data
# can only be read with the key it was written with. Back it up safely.
DATA_ENCRYPTION_KEY=

# --- Recommended ------------------------------------------------------------
# Canonical public URL. Used for OAuth redirect URIs and redirects.
# If unset on Vercel, the project's production domain is used.
APP_URL=https://your-domain.example

# --- Optional ---------------------------------------------------------------
# TLS for the database connection: leave empty for full certificate verification
# (recommended). Use "no-verify" only if your provider's certificate chain cannot
# be validated by Node (some poolers), "disable" only for local databases.
DATABASE_SSL=

# Max connections per serverless instance (default 3 on Vercel, 10 elsewhere).
DATABASE_POOL_MAX=

# Google sign-in. Authorised redirect URI in Google Cloud Console must be:
#   ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Partner API bearer secret (>= 32 chars). Leave empty to keep the API disabled.
PARTNER_API_SECRET=

# Set to 1 to skip automatic migrations during `vercel-build`.
SKIP_DB_MIGRATIONS=
